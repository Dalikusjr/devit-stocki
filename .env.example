# Modèle de configuration : copier en .env et renseigner les valeurs (le fichier .env n'est pas versionné)

# Base de données MySQL (DB_HOST accepte un port : 127.0.0.1;port=3306)
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=db_devitstocki

# Clé de chiffrement des accès projets : 32 octets en base64.
# Générer : php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# À SAUVEGARDER : sans la même clé, les accès déjà enregistrés sont illisibles.
APP_KEY=
